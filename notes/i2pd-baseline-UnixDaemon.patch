+// Объявление функции, которую мы переопределяем.
+// Сигнатура должна в точности соответствовать определению в libstdc++.
+namespace std {
+    // Атрибут noexcept обязателен, как в оригинале.
+    // _GLIBCXX_NORETURN также подразумевается, так как функция не должна возвращать управление.
+    void __glibcxx_assert_fail(const char* __file, int __line,
+                               const char* __function, const char* __condition) noexcept {
+        // 1. Выводим информацию о сработавшем ассерте.
+        std::cerr << "libstdc++ assert failed: " << __condition << "\n"
+                  << "  in function: " << __function << "\n"
+                  << "  at file: " << __file << ":" << __line << std::endl;
+
+        // 2. Выводим полный стектрейс с помощью Boost.Stacktrace.
+        std::cerr << "Stack trace:\n" << boost::stacktrace::stacktrace() << std::endl;
+
+        // 3. Завершаем программу (аналог abort()).
+        std::abort();
+    }
+} // namespace std
